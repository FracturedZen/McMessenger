<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mc_server_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_bottom_bar"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Java server"
        android:textColor="#C8E090"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/mc_server_host"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/mcmessenger_input"
            android:hint="simpcraft.com"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:padding="10dp"
            android:textColor="#F4FFE8"
            android:textColorHint="#A8D48A"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/mc_server_port"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/mcmessenger_input"
            android:hint="auto"
            android:importantForAutofill="no"
            android:inputType="number"
            android:padding="10dp"
            android:textColor="#F4FFE8"
            android:textColorHint="#A8D48A"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:text="Leave port blank unless you were told a number. PC does the same."
        android:textColor="#B5D99A"
        android:textSize="11sp" />
</LinearLayout>
