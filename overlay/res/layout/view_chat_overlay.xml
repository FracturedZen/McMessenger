<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mc_chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mcmessenger_app_bg"
    android:clickable="true"
    android:fitsSystemWindows="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/mc_chat_leave"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/mcmessenger_button"
            android:contentDescription="Back to menu"
            android:minWidth="0dp"
            android:text="Menu"
            android:textAllCaps="false"
            android:textColor="#F4FFE8" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/mcmessenger_melon_slice"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="McMessenger"
            android:textColor="#F4FFE8"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mc_chat_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="…"
            android:textColor="#C8E090"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mc_chat_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/mc_chat_autorespawn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/mcmessenger_button"
            android:text="Auto-respawn: off"
            android:textAllCaps="false"
            android:textColor="#F4FFE8" />

        <Button
            android:id="@+id/mc_chat_respawn_now"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/mcmessenger_button"
            android:text="Respawn"
            android:textAllCaps="false"
            android:textColor="#F4FFE8" />

        <Button
            android:id="@+id/mc_chat_queue"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/mcmessenger_button"
            android:text="Queue"
            android:textAllCaps="false"
            android:textColor="#F4FFE8" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/mc_chat_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingHorizontal="10dp">

        <LinearLayout
            android:id="@+id/mc_chat_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/mc_chat_composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <EditText
            android:id="@+id/mc_chat_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/mcmessenger_input"
            android:hint="Message"
            android:focusedByDefault="true"
            android:imeOptions="actionSend|flagNoExtractUi|flagNoFullscreen"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="256"
            android:textColor="#F4FFE8"
            android:textColorHint="#A8D48A"
            android:textSize="16sp" />

        <Button
            android:id="@+id/mc_chat_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/mcmessenger_button"
            android:text="Send"
            android:textAllCaps="false"
            android:textColor="#F4FFE8" />
    </LinearLayout>
</LinearLayout>
